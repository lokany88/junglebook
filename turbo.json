{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": true
    },
    "audit": {
      "dependsOn": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [],
      "cache": true
    }
  },
  "globalEnv": ["NODE_ENV", "TURBO_TOKEN", "GPG_PUBLIC_KEY_B64"],
  "tasks": {
    "jb-cli": {
      "outputs": ["dist/**", "lib/**", "*.js"]
    },
    "web": {
      "dependsOn": ["jb-cli#build"],
      "outputs": [".next/**", "dist/**"]
    }
  }
}
