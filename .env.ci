# =====================================================
# 🌍 JungleBook CI/CD Environment Template
# Cloudflare → Vercel Fallback → Slack + PR Comments
# =====================================================

# === Cloudflare Deployment ===
# Create at https://dash.cloudflare.com/profile/api-tokens
# Template: Pages → Edit → “Edit Cloudflare Pages” permission
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# === Vercel Deployment ===
# Create at https://vercel.com/account/tokens
# Then run `vercel link` locally to get the org + project IDs
VERCEL_TOKEN=your-vercel-personal-access-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# === Slack Notifications ===
# Create via Slack: https://api.slack.com/messaging/webhooks
# Choose a channel (e.g., #ci-deployments)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZZZZZ

# === GitHub Token (Automatically Provided by Actions)
# Do NOT store manually — automatically available during CI.
# GITHUB_TOKEN=${{ secrets.GITHUB_TOKEN }}

# === Optional: Vitest / Coverage ===
CODECOV_TOKEN=your-codecov-token-if-using

