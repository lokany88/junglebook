{
  "name": "junglebook",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel & npm run test:ui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:ui": "vitest --ui --open",
    "test:watch": "vitest watch",
    "format": "prettier --write .",
    "postinstall": "npm --workspace ./apps/dashboard-charts/apps/web install next react react-dom",
    "prebuild": "if [ ! -f node_modules/.bin/next ]; then npm --workspace ./apps/dashboard-charts/apps/web install next react react-dom --legacy-peer-deps; fi"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.9.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-unused-imports": "^4.1.3",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.3",
    "next": "latest",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.1.14",
    "turbo": "^2.5.8",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/*",
    "apps/dashboard-charts/apps/*",
    "packages/*",
    "packages/jb-cli"
  ]
}
